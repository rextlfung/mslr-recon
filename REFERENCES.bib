% REFERENCES.bib
% Academic papers referenced by or relevant to this codebase.
%
% Sections:
%   1. Core algorithm (MSLR)
%   2. Optimizer
%   3. Forward model (SENSE / NUFFT)
%   4. Related fMRI reconstruction work
%   5. Compressed sensing theory

% ── 1. Core algorithm ─────────────────────────────────────────────────────────

% Multi-scale low-rank decomposition: the main regularizer and the λ_k formula.
@article{ong2016beyond,
  author    = {Ong, Frank and Lustig, Michael},
  title     = {Beyond Low Rank + Sparse: Multiscale Low Rank Matrix Decomposition},
  journal   = {{IEEE} Journal of Selected Topics in Signal Processing},
  volume    = {10},
  number    = {4},
  pages     = {672--687},
  year      = {2016},
  doi       = {10.1109/JSTSP.2016.2545518},
  note      = {Source of the MSLR regularizer and the theoretically motivated λ_k formula
               used in reconstruct.jl. Eq. (4) gives λ_k only up to a constant ("~"), so the
               log base is unspecified: reconstruct.jl uses natural log while the authors'
               reference MATLAB code (demo_*.m) uses log2 (~2-3% larger λ_k). The paper also
               recommends random cycle spinning to suppress block artifacts — not implemented
               here (see figueiredo2003em and the cycle-spinning TODO in reconstruct.jl).},
}

% Translation-invariant ("cycle spinning") denoising: the technique Ong & Lustig (2016) use to
% suppress block-partition artifacts. Recorded here for the deferred cycle-spinning TODO.
@article{figueiredo2003em,
  author    = {Figueiredo, M{\'a}rio A. T. and Nowak, Robert D.},
  title     = {An {EM} Algorithm for Wavelet-Based Image Restoration},
  journal   = {{IEEE} Transactions on Image Processing},
  volume    = {12},
  number    = {8},
  pages     = {906--916},
  year      = {2003},
  doi       = {10.1109/TIP.2003.814255},
  note      = {Translation-invariant (cycle-spinning) approach to suppressing block-partition
               artifacts. MSLR (Ong & Lustig 2016) applies random cycle spinning rather than
               overlapping blocks; deferred TODO in reconstruct.jl.},
}

% ── 2. Optimizer ──────────────────────────────────────────────────────────────

% POGM with adaptive gradient restart: the algorithm implemented in src/mirt_mod.jl.
@article{kim2018adaptive,
  author    = {Kim, Donghwan and Fessler, Jeffrey A.},
  title     = {Adaptive Restart of the Optimized Gradient Method for Convex Optimization},
  journal   = {Journal of Optimization Theory and Applications},
  volume    = {178},
  number    = {1},
  pages     = {240--263},
  year      = {2018},
  doi       = {10.1007/s10957-018-1287-4},
  note      = {Source of pogm_restart (ported to Julia in src/mirt_mod.jl with GPU and
               early-stopping extensions). Introduces POGM and the gradient-direction
               restart heuristic (:gr).},
}

% FISTA / FPGM: the default momentum scheme (mom=:fpgm).
@article{beck2009fast,
  author    = {Beck, Amir and Teboulle, Marc},
  title     = {A Fast Iterative Shrinkage-Thresholding Algorithm for Linear Inverse Problems},
  journal   = {{SIAM} Journal on Imaging Sciences},
  volume    = {2},
  number    = {1},
  pages     = {183--202},
  year      = {2009},
  doi       = {10.1137/080716542},
  note      = {FISTA. The FPGM momentum update (mom=:fpgm) is the fixed-step version.},
}

% ── 3. Forward model ──────────────────────────────────────────────────────────

