  volume    = {42},
  number    = {5},
  pages     = {952--962},
  year      = {1999},
  doi       = {10.1002/(SICI)1522-2594(199911)42:5<952::AID-MRM16>3.0.CO;2-S},
  note      = {The parallel-imaging model underlying MIRT.Asense (CPU) and Asense_gpu (GPU).},
}

% Min-max NUFFT: used internally by MIRT.Asense for non-Cartesian FFT.
@article{fessler2003nonuniform,
  author    = {Fessler, Jeffrey A. and Sutton, Bradley P.},
  title     = {Nonuniform Fast {Fourier} Transforms Using Min-Max Interpolation},
  journal   = {{IEEE} Transactions on Signal Processing},
  volume    = {51},
  number    = {2},
  pages     = {560--574},
  year      = {2003},
  doi       = {10.1109/TSP.2002.807005},
  note      = {NUFFT underlying the SENSE operator in MIRT.jl.},
}

% ── 4. Related fMRI reconstruction work ───────────────────────────────────────

% k-t FASTER: low-rank + temporal subspace constraints for highly undersampled fMRI.
% Uses a 10^{-4} iterate-difference stopping criterion with a 25-iteration hard cap.
@article{chiew2015recovering,
  author    = {Chiew, Mark and Smith, Stephen M. and Koopmans, Peter J. and Graedel,
               Nadine N. and Blumensath, Thomas and Miller, Karla L.},
  title     = {Recovering Task {fMRI} Signals from Highly Under-Sampled Data with
               Low-Rank and Temporal Subspace Constraints},
  journal   = {{NeuroImage}},
  volume    = {114},
  pages     = {98--111},
  year      = {2015},
  doi       = {10.1016/j.neuroimage.2015.03.055},
  note      = {Related fMRI approach. Stopping criterion: iterate difference < 1e-4,
               max 25 iterations. The field has no strong consensus on outer-loop
               convergence tolerance; most papers use fixed iteration counts.},
}

% Dynamic L+S reconstruction using POGM; no explicit outer-loop tolerance reported.
@article{otazo2015lowrank,
  author    = {Otazo, Ricardo and Cand\`{e}s, Emmanuel and Sodickson, Daniel K.},
  title     = {Low-Rank Plus Sparse Matrix Decomposition for Accelerated Dynamic {MRI}
               with Separation of Background and Dynamic Components},
  journal   = {Magnetic Resonance in Medicine},
  volume    = {73},
  number    = {3},
  pages     = {1125--1136},
  year      = {2015},
  doi       = {10.1002/mrm.25240},
  note      = {L+S model for dynamic MRI. Reference for POGM/FISTA comparison in the
               L+S setting (Ong et al., PMC6867710).},
}

% ── 5. Compressed sensing theory ──────────────────────────────────────────────

% Nuclear norm minimization and Gaussian complexity: theoretical basis for λ_k formula.
@article{candes2011tight,
  author    = {Cand\`{e}s, Emmanuel J. and Recht, Benjamin},
  title     = {Exact Matrix Completion via Convex Optimization},
  journal   = {Foundations of Computational Mathematics},
  volume    = {9},
  number    = {6},
  pages     = {717--772},
  year      = {2009},
  doi       = {10.1007/s10208-009-9045-5},
  note      = {Nuclear norm as convex relaxation of rank; theoretical foundation for
               the nuclear-norm regularizer used in patchSVST.},
}
